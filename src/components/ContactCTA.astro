---
import { contact } from '../data/site';
---
<section class="bg-ink px-4 pb-16 pt-6 sm:px-6" aria-labelledby="contact-heading">
  <div class="reveal mx-auto grid max-w-6xl items-center gap-8 rounded-3xl border border-line px-6 py-10 sm:px-10 lg:grid-cols-2">
    <div>
      <h2 id="contact-heading" class="font-display text-3xl font-extrabold leading-tight sm:text-4xl">Get in Touch <span class="hl">Today!</span></h2>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">Let's transform your ideas into exceptional digital experiences. Tell us about your project — we reply within one working day.</p>
      <form id="contact-cta-form" novalidate class="mt-6 flex max-w-md overflow-hidden rounded-full border border-line bg-white/5">
        <label class="sr-only" for="cta-email">Email address</label>
        <input id="cta-email" type="email" required placeholder="Enter your email" aria-describedby="cta-email-error" class="w-full bg-transparent px-5 py-3.5 text-sm outline-none placeholder:text-white/40" />
        <button type="submit" data-magnetic class="shrink-0 bg-lime px-5 text-sm font-semibold text-ink transition hover:bg-white">Contact Us</button>
      </form>
      <p id="cta-email-error" class="field-error invisible text-red-400" role="alert"></p>
      <p id="contact-cta-ok" class="mt-3 hidden max-w-md text-sm font-semibold text-lime">Thanks! Your mail app will open — just press send.</p>
      <p class="mt-4 text-sm text-white/50">Or write directly: <a class="font-semibold text-white underline decoration-lime underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a> · {contact.phoneDisplay}</p>
    </div>
    <div class="flex justify-center">
      <picture>
        <source srcset="/images/contact-woman.webp" type="image/webp" />
        <img src="/images/contact-woman.png" alt="A smiling Creatix team member holding a laptop" width="520" height="620" loading="lazy" class="cutout max-h-[420px] w-auto object-contain drop-shadow-[0_24px_32px_rgba(0,0,0,0.5)]" />
      </picture>
    </div>
  </div>
</section>
