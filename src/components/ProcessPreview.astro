---
import { processSteps } from '../data/site';
---
<section class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="home-process-heading">
  <div class="mx-auto max-w-6xl">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="home-process-heading" class="font-display text-3xl font-extrabold sm:text-4xl">From first call to launch in <span class="hl">5 steps</span></h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/60">Week by week, with who you talk to and when you approve. No mystery, no surprise bills.</p>
      </div>
      <a href="/process" class="rounded-full border border-line px-4 py-2 text-sm font-semibold transition hover:border-lime hover:text-lime">See how we work →</a>
    </div>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {processSteps.map((s, i) => (
        <li class="reveal relative rounded-2xl bg-card p-5">
          <div class="flex items-center justify-between">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-lime font-display text-sm font-black text-ink" aria-hidden="true">{s.num}</span>
            <span class="text-xs font-bold text-lime">{s.weeks}</span>
          </div>
          <h3 class="mt-4 font-display text-lg font-extrabold">{s.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-white/60">{s.short}</p>
          {i < processSteps.length - 1 && (
            <span class="absolute -right-3 top-1/2 hidden h-px w-6 bg-lime/50 lg:block" aria-hidden="true"></span>
          )}
        </li>
      ))}
    </ol>
    <div class="reveal mt-6 flex flex-wrap gap-3">
      <a href="/process" class="rounded-full bg-lime px-6 py-3 text-sm font-bold text-ink transition hover:bg-white">Our full process →</a>
      <a href="/book" class="rounded-full border border-line px-6 py-3 text-sm font-semibold transition hover:border-lime hover:text-lime">Book a free call</a>
    </div>
  </div>
</section>
