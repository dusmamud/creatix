---
import { faqs } from '../data/site';
const preview = faqs.slice(0, 4);
---
<section class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="home-faq-heading">
  <div class="mx-auto max-w-3xl">
    <div class="reveal text-center">
      <h2 id="home-faq-heading" class="font-display text-3xl font-extrabold sm:text-4xl">Questions, <span class="hl">answered.</span></h2>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-white/60">The questions every new client asks — timelines, prices, ownership and support.</p>
    </div>
    <div class="mt-8 space-y-3">
      {preview.map((f) => (
        <details class="reveal group rounded-2xl bg-card p-5 open:border-lime/40">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">{f.q}<span class="shrink-0 text-lime transition group-open:rotate-45" aria-hidden="true">+</span></summary>
          <p class="mt-3 text-sm leading-relaxed text-white/70">{f.a}</p>
        </details>
      ))}
    </div>
    <div class="reveal mt-6 text-center">
      <a href="/faq" class="inline-block rounded-full bg-lime px-6 py-3 text-sm font-bold text-ink transition hover:bg-white">Read all FAQs →</a>
    </div>
  </div>
</section>
