---
import { pricingPlans } from '../data/site';
---
<section class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="home-pricing-heading">
  <div class="mx-auto max-w-6xl">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="home-pricing-heading" class="font-display text-3xl font-extrabold sm:text-4xl">Fixed prices. <span class="hl">No surprises.</span></h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/60">Four packages, one fixed quote in writing before we start. The final quote never changes mid-project.</p>
      </div>
      <a href="/pricing/" class="rounded-full border border-line px-4 py-2 text-sm font-semibold transition hover:border-lime hover:text-lime">All pricing →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {pricingPlans.map((p) => (
        <article class:list={['reveal flex flex-col rounded-2xl p-6', p.popular ? 'bg-lime text-ink' : 'bg-card']}>
          {p.popular && <p class="inline-block self-start rounded-full bg-ink px-3 py-1 text-[11px] font-black uppercase tracking-wider text-lime">Most popular</p>}
          <h3 class="mt-3 font-display text-xl font-extrabold">{p.name}</h3>
          <p class:list={['mt-1 text-sm', p.popular ? 'text-ink/70' : 'text-white/55']}>{p.bestFor}</p>
          <p class="mt-4 font-display text-3xl font-black">{p.price}</p>
          <p class:list={['text-xs', p.popular ? 'text-ink/60' : 'text-white/45']}>{p.per} · {p.timeline}</p>
          <a href={`/book/?plan=${p.slug}`} class:list={['mt-5 block rounded-full px-5 py-3 text-center text-sm font-bold transition', p.popular ? 'bg-ink text-white hover:bg-ink-2' : 'bg-lime text-ink hover:bg-white']}>Book a free call →</a>
          <a href="/pricing/" class:list={['mt-2 block text-center text-sm font-semibold underline-offset-4 hover:underline', p.popular ? 'text-ink/70' : 'text-white/60']}>See what's included</a>
        </article>
      ))}
    </div>
  </div>
</section>
