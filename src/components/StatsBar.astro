---
import { stats } from '../data/site';
---
<section class="bg-ink px-4 pb-4 pt-10 sm:px-6" aria-label="Our numbers">
  <div class="reveal mx-auto grid max-w-6xl grid-cols-2 gap-y-6 rounded-3xl border border-line px-6 py-7 sm:grid-cols-4">
    {stats.map((s) => (
      <div class="text-center">
        <p class="font-display text-3xl font-black text-white sm:text-4xl"><span data-count={s.value}>0</span><span class="text-lime">{s.suffix}</span></p>
        <p class="mt-1 text-xs text-white/60 sm:text-sm">{s.label}</p>
      </div>
    ))}
  </div>
</section>
