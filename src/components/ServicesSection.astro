---
import { services } from '../data/site';
---
<section class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="services-heading">
  <div class="reveal relative mx-auto max-w-6xl rounded-3xl bg-card px-5 py-10 sm:px-10">
    <span class="absolute -left-3 top-10 hidden -rotate-90 rounded bg-lime px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-ink lg:block" style="transform-origin: left top;">What we do</span>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 id="services-heading" class="font-display text-3xl font-extrabold leading-tight sm:text-4xl">Our <span class="hl">Services</span></h2>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/65">We offer a range of creative and digital services designed to help your brand stand out.</p>
        <ul class="mt-8 space-y-3">
          {services.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="service-row flex items-center justify-between rounded-full border border-line px-5 py-3.5 text-sm font-semibold text-white">
                <span><span class="service-num mr-3 font-display font-extrabold text-lime">{s.num}</span>{s.title}</span>
                <span class="service-arrow text-white/70" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="grid gap-4 sm:grid-cols-[1.2fr_1fr]">
        <div class="relative overflow-hidden rounded-2xl">
          <img src="/images/designer.jpg" alt="A Creatix designer at work" width="640" height="760" loading="lazy" class="h-full min-h-[280px] w-full object-cover grayscale" />
          <span class="absolute bottom-3 left-3 rounded-full bg-ink/80 px-3 py-1 text-xs font-semibold text-white">Inside the studio</span>
        </div>
        <div class="flex flex-col gap-4">
          <a href="/projects" class="group flex flex-1 flex-col justify-between rounded-2xl border border-line p-5 transition hover:border-lime">
            <span class="text-sm text-white/65">Ever wondered how design magic happens?</span>
            <span class="mt-6 flex items-center gap-2 font-display text-lg font-bold">See how we work <span class="text-lime transition group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></span>
          </a>
          <a href="/team" class="group flex flex-1 flex-col justify-between rounded-2xl bg-lime p-5 text-ink">
            <span class="text-sm font-medium text-ink/75">Looking for design experts who can bring your vision to life?</span>
            <span class="mt-6 flex items-center gap-2 font-display text-lg font-bold">Meet our expert <span class="transition group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
