---
import Layout from '../layouts/Layout.astro';
import Starburst from '../components/Starburst.astro';
import StatsBar from '../components/StatsBar.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ServicesSection from '../components/ServicesSection.astro';
import Marquee from '../components/Marquee.astro';
import ProcessPreview from '../components/ProcessPreview.astro';
import Testimonials from '../components/Testimonials.astro';
import PricingHint from '../components/PricingHint.astro';
import BlogPreview from '../components/BlogPreview.astro';
import FaqPreview from '../components/FaqPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import AwardsStrip from '../components/AwardsStrip.astro';
import { team, projects } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Creatix',
  url: 'https://creatiix.pages.dev/',
  description: 'Creatix is a creative design agency — UI/UX design, web development, 3D design and motion graphics.',
  email: 'hello@creatix.in',
  telephone: '+91 98765 43210',
  priceRange: '₹₹',
  foundingDate: '2016',
  address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressRegion: 'Maharashtra', addressCountry: 'IN' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '212' },
  image: 'https://creatiix.pages.dev/images/og-home.jpg',
  logo: 'https://creatiix.pages.dev/favicon.svg',
};
const lead = 'Creatix is a creative design agency. From web development to branding, we deliver innovative strategies that elevate your brand and drive growth.';
const tags = ['UX Design', 'App Design', 'Dashboard', 'Wireframe', 'User Research', 'Branding', 'Motion Design', 'Web Design'];
---
<Layout
  title="Creatix — Empowering Brands Through Creative Solutions"
  description="Creatix is a creative design agency. From web development to branding, we deliver innovative strategies that elevate your brand and drive growth."
  jsonLd={jsonLd}
  lead={lead}
>
  <!-- HERO (light) — like the design: headline flanked by starbursts, left copy +
       "Innovate Your Brand" pill, centre cutout on a pale grey circle with a
       hand-drawn arrow doodle, right stars + "10 Years Experience". The CTA
       row straddles the hero's rounded bottom edge, as in the design. -->
  <section class="relative overflow-hidden rounded-b-[2.5rem] bg-mist px-4 pb-14 pt-28 text-ink sm:px-6 sm:pt-32">
    <div class="mx-auto max-w-6xl text-center">
      <div class="flex items-start justify-center gap-3 sm:gap-5">
        <span data-hero class="mt-2 hidden shrink-0 sm:block"><Starburst size={44} class="spin-slow" /></span>
        <h1 data-split class="max-w-4xl font-display text-4xl font-black leading-[1.05] tracking-tight sm:text-6xl">Empowering Brands Through <span class="whitespace-nowrap">Creative Solutions</span></h1>
        <span data-hero class="mt-8 hidden shrink-0 sm:block"><Starburst size={36} class="spin-slow" /></span>
      </div>
      <div class="relative mx-auto mt-6 grid max-w-5xl items-end gap-6 md:grid-cols-[1fr_auto_1fr]">
        <div data-hero class="order-2 text-center md:order-1 md:pb-16 md:text-left">
          <p class="mx-auto max-w-[280px] text-sm leading-relaxed text-ink/70 md:mx-0 md:max-w-[240px]">From web development to branding, we deliver innovative strategies that elevate your brand and drive growth. Let's create something exceptional together.</p>
          <a href="/services/" class="mt-4 inline-block rounded-full border border-ink/30 px-4 py-2 text-xs font-semibold transition hover:border-ink hover:bg-ink hover:text-white">Innovate Your Brand</a>
        </div>
        <div data-hero data-parallax class="relative order-1 md:order-2">
          <div class="absolute left-1/2 top-6 -z-0 h-72 w-72 -translate-x-1/2 rounded-full bg-ink/5 sm:h-96 sm:w-96" aria-hidden="true"></div>
          <picture class="mx-auto block aspect-[2/3] h-[380px] sm:h-[480px]">
            <source srcset="/images/hero-woman.webp" type="image/webp" />
            <img src="/images/hero-woman.png" alt="Smiling Creatix team member celebrating a successful project" width="512" height="768" fetchpriority="high" class="cutout relative z-10 mx-auto h-full w-auto object-contain" />
          </picture>
          <svg class="absolute -left-2 bottom-24 z-20 hidden h-16 w-16 -rotate-12 md:block" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M50 8c-14 4-22 14-24 28-1 8 2 14 8 18" stroke="#0b0b0b" stroke-width="2.5" stroke-linecap="round"/><path d="M34 52l-4 8 10-2" stroke="#0b0b0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div data-hero class="order-3 text-center md:pb-16 md:text-right">
          <p class="flex justify-center text-lime-deep text-lg leading-none tracking-tight md:justify-end" role="img" aria-label="Rated 5 out of 5 stars">★★★★★</p>
          <p class="mt-2 font-display text-2xl font-extrabold">10 Years</p>
          <p class="text-sm text-ink/60">Experience</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA row straddling the hero edge, as in the design -->
  <div data-hero class="relative z-20 -mt-7 flex flex-col items-center gap-3 px-4 sm:flex-row sm:justify-center">
    <a href="/contact/" data-magnetic class="w-full max-w-xs rounded-full bg-lime px-6 py-3 text-center text-sm font-bold text-ink shadow-lg shadow-lime/30 transition hover:bg-white sm:w-auto">Start Your Project</a>
    <a href="/about/" data-magnetic class="w-full max-w-xs rounded-full border border-ink/30 bg-mist px-6 py-3 text-center text-sm font-semibold text-ink transition hover:bg-ink hover:text-white sm:w-auto">Let's Collaborate</a>
  </div>

  <StatsBar />

  <ClientLogos />

  <!-- MASTERPIECES -->
  <section id="masterpieces" class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="masterpieces-heading">
    <div class="mx-auto max-w-6xl">
      <div class="reveal grid gap-6 md:grid-cols-2 md:items-end">
        <h2 id="masterpieces-heading" class="font-display text-3xl font-extrabold leading-tight sm:text-4xl">Turning Ideas Into<br />Masterpieces</h2>
        <p class="max-w-md text-sm leading-relaxed text-white/65 md:justify-self-end">We may be a compact team, but our creativity knows no bounds. By staying agile and working hand-in-hand with our clients, we transform ideas into cutting-edge designs that make a lasting impression.</p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-[1.6fr_1fr]">
        <figure class="reveal relative overflow-hidden rounded-2xl">
          <span class="absolute left-3 top-3 z-10" aria-hidden="true"><Starburst size={40} class="spin-slow" /></span>
          <picture class="contents">
            <source srcset="/images/office-team-800.webp 800w, /images/office-team.webp 1280w" sizes="(max-width: 768px) 100vw, 700px" type="image/webp" />
            <img src="/images/office-team.jpg" srcset="/images/office-team-800.jpg 800w, /images/office-team.jpg 1280w" sizes="(max-width: 768px) 100vw, 700px" alt="The Creatix team working together in the studio" width="1280" height="853" loading="lazy" data-parallax-img class="h-full min-h-[260px] w-full scale-[1.08] object-cover grayscale" />
          </picture>
          <figcaption class="absolute bottom-4 left-4 flex items-center gap-2 rounded-r-lg bg-lime px-4 py-3 font-display text-sm font-extrabold uppercase tracking-wide text-ink">A Creative Design<br />Agency <span class="ml-1 flex gap-0.5" aria-hidden="true"><span class="h-8 w-1 bg-ink/70"></span><span class="h-8 w-1 bg-ink/70"></span><span class="h-8 w-1 bg-ink/70"></span></span></figcaption>
        </figure>
        <figure class="reveal relative overflow-hidden rounded-2xl">
          <picture class="contents">
            <source srcset="/images/thinking-woman-640.webp 640w, /images/thinking-woman.webp 900w" sizes="(max-width: 768px) 100vw, 450px" type="image/webp" />
            <img src="/images/thinking-woman.jpg" srcset="/images/thinking-woman-640.jpg 640w, /images/thinking-woman.jpg 900w" sizes="(max-width: 768px) 100vw, 450px" alt="A designer thinking through a new idea" width="900" height="1350" loading="lazy" data-parallax-img class="h-full min-h-[260px] w-full scale-[1.08] object-cover grayscale" />
          </picture>
          <svg class="absolute right-4 top-4 h-12 w-12" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 6a10 10 0 0 0-6 18c1.5 1.2 2 2.6 2 4h8c0-1.4.5-2.8 2-4A10 10 0 0 0 24 6Z" stroke="#f472b6" stroke-width="2"/><path d="M20 36h8M21 41h6" stroke="#f472b6" stroke-width="2" stroke-linecap="round"/></svg>
        </figure>
      </div>
    </div>
  </section>

  <ServicesSection />

  <Marquee />

  <ProcessPreview />

  <!-- TEAM -->
  <section id="team" class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="team-heading">
    <div class="mx-auto max-w-6xl">
      <div class="reveal flex flex-wrap items-center justify-between gap-4">
        <h2 id="team-heading" class="font-display text-3xl font-extrabold sm:text-4xl">Meet <span class="hl">the Team</span></h2>
        <a href="/team/" class="rounded-full border border-line px-4 py-2 text-sm font-semibold transition hover:border-lime hover:text-lime">View full team →</a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((m) => (
          <article class="reveal rounded-2xl bg-mist p-5 text-ink transition hover:-translate-y-1">
            <div class="flex items-center gap-3">
              <span class="relative grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-full bg-lime ring-2 ring-lime/50">
                <picture class="contents">
                  <source srcset={m.img.replace('.jpg', '.webp')} type="image/webp" />
                  <img src={m.img} alt={`Portrait of ${m.name}`} width="96" height="96" loading="lazy" class="h-full w-full bg-lime/40 object-cover" />
                </picture>
              </span>
              <div>
                <h3 class="font-display text-base font-extrabold leading-tight">{m.name}</h3>
                <p class="text-xs font-semibold text-ink/60">{m.role}</p>
              </div>
              <span class="ml-auto text-lime-deep" aria-hidden="true">✦</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- FEATURED WORK -->
  <section id="work" class="bg-ink px-4 py-14 sm:px-6" aria-labelledby="work-heading">
    <div class="mx-auto max-w-6xl">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <h2 id="work-heading" class="font-display text-3xl font-extrabold sm:text-4xl">Recent <span class="hl">Work</span></h2>
        <a href="/projects/" class="rounded-full border border-line px-4 py-2 text-sm font-semibold transition hover:border-lime hover:text-lime">All projects →</a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.slice(0, 3).map((p) => (
          <a href={`/projects/${p.slug}/`} class="reveal project-card group overflow-hidden rounded-2xl bg-card">
            <picture class="contents">
              <source srcset={`${p.img.replace('.jpg', '-640.webp')} 640w, ${p.img.replace('.jpg', '.webp')} 1280w`} sizes="(max-width: 768px) 100vw, 400px" type="image/webp" />
              <img src={p.img} srcset={`${p.img.replace('.jpg', '-640.jpg')} 640w, ${p.img} 1280w`} sizes="(max-width: 768px) 100vw, 400px" alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full bg-card-2 object-cover transition duration-300 group-hover:scale-105" />
            </picture>
            <div class="p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-lime">{p.category} · {p.year}</p>
              <h3 class="mt-1 font-display text-lg font-extrabold group-hover:text-lime">{p.title}</h3>
              <p class="mt-1 text-sm text-white/60">{p.summary}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-lime">View case study <span class="card-arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <AwardsStrip showClients={false} />

  <PricingHint />

  <BlogPreview />

  <FaqPreview />

  <!-- TAGS MARQUEE -->
  <div class="overflow-hidden border-y border-line bg-white py-3" aria-hidden="true">
    <div class="marquee-track-slow flex w-max items-center gap-6 whitespace-nowrap">
      {[0, 1].map(() => (
        <span class="flex items-center gap-6">
          {[...tags, ...tags].map((t) => (
            <span class="flex items-center gap-6"><span class="font-display text-sm font-bold uppercase tracking-wide text-ink/70">{t}</span><span class="text-lime-deep">✦</span></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <ContactCTA />
</Layout>
