---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { faqs } from '../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const lead = 'Answers to the questions every new client asks — timelines, prices, ownership and support. Anything else? Write to hello@creatix.in.';
---
<Layout title="FAQ — Creatix | Timelines, Prices & Support" description="Frequently asked questions about Creatix: project timelines, prices, file ownership and post-launch support." jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="FAQ" title="Questions, answered." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-3xl space-y-3">
      {faqs.map((f, i) => (
        <div class="faq-item reveal rounded-2xl bg-card">
          <button type="button" data-faq-btn aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-panel-${i}`} id={`faq-btn-${i}`} class="flex w-full items-center justify-between gap-4 p-5 text-left font-display text-lg font-bold">{f.q}<span class="faq-icon shrink-0 text-lime" aria-hidden="true">+</span></button>
          <div id={`faq-panel-${i}`} class="faq-panel" data-open={i === 0 ? 'true' : 'false'} role="region" aria-labelledby={`faq-btn-${i}`}><div><p class="px-5 pb-5 text-sm leading-relaxed text-white/70">{f.a}</p></div></div>
        </div>
      ))}
    </div>
  </section>
  <ContactCTA />
</Layout>
