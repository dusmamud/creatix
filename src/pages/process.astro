---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { processSteps } from '../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How working with Creatix works',
  description: 'The Creatix process: Discover, Design, Build, Launch, Grow — week by week, with who you talk to and when you approve.',
  step: processSteps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: `${s.weeks}. ${s.detail} ${s.approval}` })),
};
const lead = 'No mystery, no endless revisions, no surprise bills. Here is exactly what happens after you reach out — week by week, who you talk to, and what you approve at each step.';
---
<Layout title="Our Process — Creatix" description="How working with Creatix works: Discover, Design, Build, Launch, Grow. Week-by-week timeline, who you talk to, and when you approve." jsonLd={jsonLd} lead={lead} ogImage="https://creatiix.pages.dev/images/og-process.jpg">
  <PageHero eyebrow="How we work" title="What happens after you reach out." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-4xl">
      <ol class="relative space-y-6 border-l-2 border-lime/40 pl-0">
        {processSteps.map((s) => (
          <li class="reveal relative ml-6 rounded-2xl bg-card p-6 sm:p-8">
            <span class="absolute -left-[2.35rem] top-6 grid h-10 w-10 place-items-center rounded-full bg-lime font-display text-sm font-black text-ink" aria-hidden="true">{s.num}</span>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="font-display text-2xl font-extrabold">{s.title}</h2>
              <span class="rounded-full bg-lime/15 px-3 py-1 text-xs font-bold text-lime">{s.weeks}</span>
            </div>
            <p class="mt-3 leading-relaxed text-white/70">{s.detail}</p>
            <p class="mt-4 text-sm"><span class="font-semibold text-white">You talk to: </span><span class="text-white/65">{s.who}</span></p>
            <p class="mt-2 rounded-xl bg-lime/10 px-4 py-3 text-sm font-semibold text-lime">✓ {s.approval}</p>
          </li>
        ))}
      </ol>
      <div class="reveal mt-10 rounded-2xl bg-mist p-6 text-ink sm:p-8">
        <h2 class="font-display text-2xl font-extrabold">Typical timelines</h2>
        <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
          <li class="rounded-xl bg-white p-4"><strong>Landing page</strong><br /><span class="text-ink/65">1–2 weeks</span></li>
          <li class="rounded-xl bg-white p-4"><strong>Full website</strong><br /><span class="text-ink/65">3–5 weeks</span></li>
          <li class="rounded-xl bg-white p-4"><strong>Brand identity</strong><br /><span class="text-ink/65">4–6 weeks</span></li>
        </ul>
        <p class="mt-4 text-sm text-ink/70">Every project includes two revision rounds and 30 days of free post-launch fixes. See fixed starting prices on the <a href="/pricing" class="font-semibold underline underline-offset-4">pricing page</a>.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/book" class="rounded-full bg-ink px-6 py-3 text-sm font-bold text-white transition hover:bg-ink-2">Book a free call →</a>
          <a href="/contact" class="rounded-full border border-ink/30 px-6 py-3 text-sm font-semibold transition hover:bg-ink hover:text-white">Start your project</a>
        </div>
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
