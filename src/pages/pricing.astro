---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { pricingPlans, faqs } from '../data/site';
const pricingFaqs = faqs.filter((f) => f.q.toLowerCase().includes('cost') || f.q.toLowerCase().includes('long') || f.q.toLowerCase().includes('own') || f.q.toLowerCase().includes('support'));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: pricingPlans.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: `Creatix ${p.name}`, description: p.bestFor, offers: { '@type': 'Offer', priceCurrency: 'INR', price: p.price.replace(/[₹,]/g, ''), availability: 'https://schema.org/InStock' } } })),
};
const lead = 'Four fixed starting prices. No hourly billing, no hidden charges — the final quote is fixed in writing after a free discovery call, and it never changes mid-project.';
---
<Layout title="Pricing — Creatix" description="Creatix pricing: Motion from ₹29,999, 3D & Visuals from ₹39,999, UI/UX Design from ₹49,999, Website from ₹59,999. Fixed quotes, no hidden charges." jsonLd={jsonLd} lead={lead} ogImage="https://creatiix.pages.dev/images/og-pricing.jpg">
  <PageHero eyebrow="Pricing" title="Fixed prices. No surprises." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {pricingPlans.map((p) => (
          <article class:list={['reveal flex flex-col rounded-2xl p-6', p.popular ? 'bg-lime text-ink ring-4 ring-lime/40' : 'bg-card']}>
            {p.popular && <p class="rounded-full bg-ink px-3 py-1 text-[11px] font-black uppercase tracking-wider text-lime inline-block self-start">Most popular</p>}
            <h2 class="mt-3 font-display text-xl font-extrabold">{p.name}</h2>
            <p class:list={['mt-1 text-sm', p.popular ? 'text-ink/70' : 'text-white/55']}>{p.bestFor}</p>
            <p class="mt-4 font-display text-4xl font-black">{p.price}</p>
            <p class:list={['text-xs', p.popular ? 'text-ink/60' : 'text-white/45']}>{p.per} · {p.timeline}</p>
            <ul class="mt-5 flex-1 space-y-2.5 text-sm">
              {p.features.map((f) => (<li class="flex gap-2"><span class={p.popular ? 'font-black' : 'text-lime'}>✓</span>{f}</li>))}
            </ul>
            <a href={`/book/?plan=${p.slug}`} class:list={['mt-6 block rounded-full px-5 py-3 text-center text-sm font-bold transition', p.popular ? 'bg-ink text-white hover:bg-ink-2' : 'bg-lime text-ink hover:bg-white']}>Book a free call →</a>
            <a href={`/services/${p.slug}/`}` class:list={['mt-2 block text-center text-sm font-semibold underline-offset-4 hover:underline', p.popular ? 'text-ink/70' : 'text-white/60']}>About this service</a>
          </article>
        ))}
      </div>
      <div class="reveal mt-10 rounded-2xl bg-card p-6 sm:p-8">
        <h2 class="font-display text-2xl font-extrabold">What every project includes</h2>
        <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
          {['Fixed quote in writing before we start', 'Two revision rounds included', 'You own all files and licences', '30 days of free post-launch fixes'].map((t) => (<li class="flex items-start gap-3 rounded-xl bg-ink p-4"><span class="text-lime">✓</span>{t}</li>))}
        </ul>
        <p class="mt-4 text-sm text-white/60">Need something bigger — e-commerce, a full rebrand, a campaign across formats? <a href="/contact/" class="font-semibold text-lime underline-offset-4 hover:underline">Tell us about it</a> and we will quote it as one fixed price. See <a href="/process/" class="font-semibold text-lime underline-offset-4 hover:underline">how the process works</a> first.</p>
      </div>
      <h2 class="reveal mt-14 font-display text-2xl font-extrabold">Pricing questions</h2>
      <div class="mt-6 space-y-3">
        {pricingFaqs.map((f, i) => (
          <div class="faq-item reveal rounded-2xl bg-card">
            <button type="button" data-faq-btn aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`pricing-faq-panel-${i}`} id={`pricing-faq-btn-${i}`} class="flex w-full items-center justify-between gap-4 p-5 text-left font-display text-lg font-bold">{f.q}<span class="faq-icon shrink-0 text-lime" aria-hidden="true">+</span></button>
            <div id={`pricing-faq-panel-${i}`} class="faq-panel" data-open={i === 0 ? 'true' : 'false'} role="region" aria-labelledby={`pricing-faq-btn-${i}`}><div><p class="px-5 pb-5 text-sm leading-relaxed text-white/70">{f.a}</p></div></div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
