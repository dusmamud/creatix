---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { testimonials } from '../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: testimonials.map((t, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Review', author: { '@type': 'Person', name: t.name }, reviewBody: t.quote, reviewRating: { '@type': 'Rating', ratingValue: '5' } } })),
};
const lead = 'Creatix holds a 4.9 out of 5 average across 212 client reviews. Here is what founders and marketing teams say after working with us.';
---
<Layout title="Reviews — Creatix" description="Client reviews for Creatix: 4.9 out of 5 across 212 reviews. Read what founders and marketing teams say." jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="Reviews" title="Clients who would hire us again." lead={lead} />
  <section class="bg-ink px-4 pt-6 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-2">
      {testimonials.map((t) => (
        <figure class="reveal rounded-2xl bg-card p-7">
          <span class="font-display text-4xl font-black leading-none text-lime" aria-hidden="true">“</span>
          <blockquote class="mt-1 leading-relaxed text-white/90">{t.quote}</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <img src={t.img} alt="" width="48" height="48" loading="lazy" class="h-12 w-12 rounded-full bg-white/10 object-cover" />
            <span><span class="block font-semibold">{t.name}</span><span class="block text-sm text-white/55">{t.company}</span></span>
            <span class="ml-auto text-lime" aria-label="5 out of 5 stars">★★★★★</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <Testimonials />
  <ContactCTA />
</Layout>
