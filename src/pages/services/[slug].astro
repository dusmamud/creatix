---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services, projects } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const related = projects.filter((p) => p.service === service.title);
const description = `${service.short} ${service.title} by Creatix — fixed quotes, senior team, 10+ years.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description,
  serviceType: service.title,
  areaServed: 'Worldwide',
  provider: { '@type': 'ProfessionalService', name: 'Creatix', url: 'https://creatiix.pages.dev/', image: 'https://creatiix.pages.dev/images/og-home.jpg', telephone: '+91 98765 43210', priceRange: '₹₹', address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressRegion: 'Maharashtra', addressCountry: 'IN' } },
};
const lead = `${service.title} at Creatix — ${service.short} Starting ${service.price.toLowerCase()}.`;
---
<Layout title={`${service.title} — Creatix`} description={description} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow={`Service ${service.num}`} title={service.title} lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div class="reveal">
        <h2 class="font-display text-2xl font-extrabold">What's included</h2>
        <ul class="mt-4 space-y-3">
          {service.points.map((p) => (
            <li class="flex items-start gap-3 rounded-2xl bg-card p-4 text-sm"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-lime text-xs font-black text-ink">✓</span>{p}</li>
          ))}
        </ul>
        <h2 class="mt-10 font-display text-2xl font-extrabold">How it works</h2>
        <ol class="mt-4 space-y-3 text-sm leading-relaxed text-white/70">
          <li><strong class="text-white">1. Free discovery call</strong> — we understand your goals, audience and budget.</li>
          <li><strong class="text-white">2. Fixed quote &amp; timeline</strong> — no hourly billing, no surprises.</li>
          <li><strong class="text-white">3. Design &amp; review</strong> — you see progress every week and give feedback.</li>
          <li><strong class="text-white">4. Launch &amp; support</strong> — we ship, then fix anything free for 30 days.</li>
        </ol>
      </div>
      <aside class="reveal h-fit rounded-2xl bg-lime p-6 text-ink">
        <p class="font-display text-3xl font-black">{service.price}</p>
        <p class="mt-1 text-sm font-medium text-ink/70">Fixed starting price. Final quote after a free discovery call.</p>
        <a href="/contact/" class="mt-5 block rounded-full bg-ink px-6 py-3 text-center text-sm font-bold text-white transition hover:bg-ink-2">Start Your Project →</a>
        <a href="/book/" class="mt-3 block rounded-full border border-ink/30 px-6 py-3 text-center text-sm font-bold transition hover:bg-ink hover:text-white">Book a free 30-min call →</a>
        <a href="/process/" class="mt-3 block text-center text-sm font-semibold underline underline-offset-4">See how our process works</a>
        <a href="/pricing/" class="mt-2 block text-center text-sm font-semibold underline underline-offset-4">Compare all packages</a>
        <a href="/faq/" class="mt-2 block text-center text-sm font-semibold underline underline-offset-4">Read the FAQ</a>
      </aside>
    </div>
    {related.length > 0 && (
      <div class="mx-auto mt-14 max-w-6xl">
        <h2 class="reveal font-display text-2xl font-extrabold">Recent {service.title.toLowerCase()} work</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {related.map((p) => (
            <a href={`/projects/${p.slug}/`}` class="reveal group overflow-hidden rounded-2xl bg-card">
              <picture class="contents">
                <source srcset={`${p.img.replace('.jpg', '-640.webp')} 640w, ${p.img.replace('.jpg', '.webp')} 1280w`} sizes="(max-width: 768px) 100vw, 400px" type="image/webp" />
                <img src={p.img} srcset={`${p.img.replace('.jpg', '-640.jpg')} 640w, ${p.img} 1280w`} sizes="(max-width: 768px) 100vw, 400px" alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full object-cover transition group-hover:scale-105" />
              </picture>
              <div class="p-5"><h3 class="font-display text-lg font-extrabold group-hover:text-lime">{p.title}</h3><p class="mt-1 text-sm text-white/60">{p.summary}</p></div>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="mx-auto mt-10 flex max-w-6xl flex-wrap gap-3">
      {services.filter((s) => s.slug !== service.slug).map((s) => (
        <a href={`/services/${s.slug}/`}` class="rounded-full border border-line px-4 py-2 text-sm font-semibold transition hover:border-lime hover:text-lime">{s.num} {s.title} →</a>
      ))}
    </div>
  </section>
  <ContactCTA />
</Layout>
