---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services } from '../../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Service', name: s.title, url: `https://creatix.pages.dev/services/${s.slug}/`, description: s.short } })),
};
const lead = 'Four services, one goal: a brand people remember. UI/UX design, web development, 3D design and motion graphics — each with a fixed starting price and a senior team.';
---
<Layout title="Our Services — Creatix" description="UI/UX design, web development, 3D design and motion graphics — fixed prices, senior team, work we are proud to sign." jsonLd={jsonLd} lead={lead} ogImage="https://creatix.pages.dev/images/og-services.jpg">
  <PageHero eyebrow="What we do" title="Services that make brands stand out." lead={lead} />
  <ServicesSection />
  <section class="bg-ink px-4 pb-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-2">
      {services.map((s) => (
        <a href={`/services/${s.slug}`} class="reveal group rounded-2xl border border-line p-6 transition hover:border-lime">
          <p class="font-display text-sm font-extrabold text-lime">{s.num} · {s.price}</p>
          <h2 class="mt-2 font-display text-2xl font-extrabold group-hover:text-lime">{s.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-white/65">{s.short}</p>
          <ul class="mt-4 space-y-1 text-sm text-white/75">{s.points.map((p) => (<li>✓ {p}</li>))}</ul>
          <span class="mt-4 inline-block text-sm font-semibold text-lime">Learn more →</span>
        </a>
      ))}
    </div>
  </section>
  <ContactCTA />
</Layout>
