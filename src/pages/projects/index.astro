---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { projects } from '../../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'CreativeWork', name: p.title, url: `https://creatix.pages.dev/projects/${p.slug}/` } })),
};
const lead = 'Selected work from the Creatix studio — brand identities, apps, dashboards, 3D campaigns and motion films for startups and growing brands.';
---
<Layout title="Projects — Creatix" description="Selected Creatix work: brand identity, app redesign, dashboards, 3D campaigns and motion films." jsonLd={jsonLd} lead={lead} ogImage="https://creatix.pages.dev/images/og-projects.jpg">
  <PageHero eyebrow="Our work" title="Turning ideas into masterpieces." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}`} class="reveal group overflow-hidden rounded-2xl bg-card">
          <img src={p.img} alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full object-cover transition duration-300 group-hover:scale-105" />
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-lime">{p.category} · {p.service} · {p.year}</p>
            <h2 class="mt-1 font-display text-lg font-extrabold group-hover:text-lime">{p.title}</h2>
            <p class="mt-1 text-sm text-white/60">{p.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <ContactCTA />
</Layout>
