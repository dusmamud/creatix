---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { projects } from '../../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'CreativeWork', name: p.title, url: `https://creatiix.pages.dev/projects/${p.slug}/` } })),
};
const lead = 'Selected work from the Creatix studio — brand identities, apps, dashboards, 3D campaigns and motion films for startups and growing brands.';
const categories = [...new Set(projects.map((p) => p.category))];
---
<Layout title="Projects — Creatix" description="Selected Creatix work: brand identity, app redesign, dashboards, 3D campaigns and motion films." jsonLd={jsonLd} lead={lead} ogImage="https://creatiix.pages.dev/images/og-projects.jpg">
  <PageHero eyebrow="Our work" title="Turning ideas into masterpieces." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div id="project-filter" class="reveal flex flex-wrap gap-2" role="group" aria-label="Filter projects by category">
        <button type="button" data-filter="All" aria-pressed="true" class="rounded-full border border-lime bg-lime px-4 py-2 text-sm font-semibold text-ink transition hover:border-lime">All</button>
        {categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false" class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-white/85 transition hover:border-lime hover:text-lime">{c}</button>
        ))}
      </div>
      <p id="filter-count" class="mt-3 text-sm text-white/55" role="status">Showing {projects.length} of {projects.length} projects</p>
    </div>
    <div class="mx-auto mt-6 grid max-w-6xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}`} data-project-card data-category={p.category} class="reveal project-card group overflow-hidden rounded-2xl bg-card">
          <img src={p.img} alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full bg-card-2 object-cover transition duration-300 group-hover:scale-105" />
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-lime">{p.category} · {p.service} · {p.year}</p>
            <h2 class="mt-1 font-display text-lg font-extrabold group-hover:text-lime">{p.title}</h2>
            <p class="mt-1 text-sm text-white/60">{p.summary}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-lime">View case study <span class="card-arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <ContactCTA />
</Layout>
