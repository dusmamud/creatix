---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { projects, services, caseStudies } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const cs = caseStudies[project.slug];
const service = services.find((s) => s.title === project.service);
const idx = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
const others = projects.filter((p) => p.slug !== project.slug).slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  dateCreated: project.year,
  creator: { '@type': 'Organization', name: 'Creatix', url: 'https://creatiix.pages.dev/' },
};
const lead = `${project.title} — ${project.summary}`;
---
<Layout title={`${project.title} — Creatix`} description={project.summary} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow={`${project.category} · ${project.year}`} title={project.title} lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <img src={project.img} alt={project.title} width="1200" height="800" class="reveal w-full rounded-2xl object-cover" />
      {cs && (
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {cs.metrics.map((m) => (
            <div class="reveal rounded-2xl bg-lime p-6 text-ink">
              <p class="font-display text-4xl font-black">{m.value}</p>
              <p class="mt-1 text-sm font-semibold text-ink/70">{m.label}</p>
            </div>
          ))}
        </div>
      )}
      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_320px]">
        <div class="reveal">
          <h2 class="font-display text-2xl font-extrabold">The challenge</h2>
          <p class="mt-3 leading-relaxed text-white/70">{cs ? cs.challenge : 'The client came to us with a clear goal and a tight deadline. Our job was to turn that brief into design that works in the real world — not just in a presentation.'}</p>
          <h2 class="mt-8 font-display text-2xl font-extrabold">The solution</h2>
          <p class="mt-3 leading-relaxed text-white/70">{cs ? cs.solution : 'A complete, launch-ready package: the core design, supporting assets and a handover the client’s team could actually use.'}</p>
          {cs && (
            <>
              <h2 class="mt-8 font-display text-2xl font-extrabold">Gallery</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {cs.gallery.map((g, i) => (
                  <img src={g} alt={`${project.title} — gallery image ${i + 1}`} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full rounded-2xl object-cover" />
                ))}
              </div>
              <blockquote class="mt-8 rounded-2xl border-l-4 border-lime bg-card p-6">
                <p class="font-display text-xl font-bold leading-relaxed">“{cs.quote.text}”</p>
                <footer class="mt-3 text-sm text-white/55">— {cs.quote.name}, {cs.quote.role}</footer>
              </blockquote>
            </>
          )}
          <h2 class="mt-8 font-display text-2xl font-extrabold">What we delivered</h2>
          <p class="mt-3 leading-relaxed text-white/70">A complete, launch-ready package: the core design, supporting assets and a handover the client's team could actually use. Thirty days of free post-launch support included, as with every Creatix project.</p>
        </div>
        <aside class="reveal h-fit rounded-2xl bg-card p-6 text-sm lg:sticky lg:top-28">
          <dl class="space-y-3">
            <div class="flex justify-between gap-4"><dt class="text-white/55">Client</dt><dd class="font-semibold">{project.title.split(' — ')[0]}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/55">Service</dt><dd class="font-semibold">{project.service}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/55">Year</dt><dd class="font-semibold">{project.year}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/55">Category</dt><dd class="font-semibold">{project.category}</dd></div>
          </dl>
          {service && <a href={`/services/${service.slug}`} class="mt-5 block rounded-full bg-lime px-5 py-3 text-center font-bold text-ink transition hover:bg-white">See {service.title} →</a>}
          <a href="/contact" class="mt-3 block rounded-full border border-line px-5 py-3 text-center font-semibold transition hover:border-lime hover:text-lime">Start a similar project</a>
          <a href={`/projects/${next.slug}`} class="mt-3 block rounded-full border border-line px-5 py-3 text-center font-semibold transition hover:border-lime hover:text-lime">Next project: {next.title.split(' — ')[0]} →</a>
        </aside>
      </div>
      <h2 class="reveal mt-14 font-display text-2xl font-extrabold">More projects</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {others.map((p) => (
          <a href={`/projects/${p.slug}`} class="reveal group overflow-hidden rounded-2xl bg-card">
            <img src={p.img} alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full object-cover transition group-hover:scale-105" />
            <div class="p-4"><h3 class="font-display font-extrabold group-hover:text-lime">{p.title}</h3><p class="text-xs text-white/55">{p.category} · {p.year}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
