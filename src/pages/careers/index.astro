---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { jobs, jobPerks } from '../../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: jobs.map((j, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'JobPosting', title: j.title, description: j.intro, employmentType: 'FULL_TIME', hiringOrganization: { '@type': 'Organization', name: 'Creatix', sameAs: 'https://creatiix.pages.dev/' }, jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' } } } })),
};
const lead = 'We stay small on purpose — so every hire works on real client launches with senior people, not on internal mock briefs. These roles are open now.';
---
<Layout title="Careers — Creatix" description="Work at Creatix: open roles for UI/UX Designer, Frontend Developer, 3D Artist and Motion Designer in Mumbai (hybrid). Real client work, senior team." jsonLd={jsonLd} lead={lead} ogImage="https://creatiix.pages.dev/images/og-careers.jpg">
  <PageHero eyebrow="Careers" title="Come make work you can sign." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="reveal font-display text-2xl font-extrabold">Open roles</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {jobs.map((j) => (
          <a href={`/careers/${j.slug}/`}` class="reveal group rounded-2xl bg-card p-6 transition hover:border-lime/50">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display text-xl font-extrabold group-hover:text-lime">{j.title}</h3>
              <span class="shrink-0 rounded-full bg-lime px-3 py-1 text-[11px] font-black uppercase tracking-wider text-ink">{j.dept}</span>
            </div>
            <p class="mt-2 text-sm text-white/60">{j.type} · {j.experience} · {j.salary}</p>
            <p class="mt-3 text-sm leading-relaxed text-white/70">{j.intro}</p>
            <p class="mt-4 text-sm font-bold text-lime">View role →</p>
          </a>
        ))}
      </div>
      <div class="reveal mt-10 rounded-2xl bg-mist p-6 text-ink sm:p-8">
        <h2 class="font-display text-2xl font-extrabold">What we offer</h2>
        <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
          {jobPerks.map((p) => (<li class="flex items-start gap-3 rounded-xl bg-white p-4"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-lime text-xs font-black">✓</span>{p}</li>))}
        </ul>
        <p class="mt-4 text-sm text-ink/70">No role that fits? Write to <a href="mailto:hello@creatix.in?subject=Careers%20—%20Creatix" class="font-semibold underline underline-offset-4">hello@creatix.in</a> with your portfolio — we keep good people on file.</p>
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
