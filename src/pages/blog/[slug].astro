---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { blogPosts, team } from '../../data/site';

export function getStaticPaths() {
  return blogPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const author = team.find((t) => t.name === post.author);
const related = blogPosts.filter((p) => p.slug !== post.slug && p.category === post.category).concat(blogPosts.filter((p) => p.slug !== post.slug && p.category !== post.category)).slice(0, 3);
const wordCount = post.body.join(' ').split(/\s+/).length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  author: { '@type': 'Person', name: post.author, jobTitle: post.authorRole },
  publisher: { '@type': 'Organization', name: 'Creatix', url: 'https://creatiix.pages.dev/' },
  mainEntityOfPage: `https://creatiix.pages.dev/blog/${post.slug}/`,
  wordCount,
};
const lead = post.excerpt;
---
<Layout title={`${post.title} — Creatix Blog`} description={post.excerpt} jsonLd={jsonLd} lead={lead} ogImage="https://creatiix.pages.dev/images/og-blog.jpg">
  <PageHero eyebrow={`${post.category} · ${post.readingTime}`} title={post.title} lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <picture class="contents">
        <source srcset={`${post.img.replace('.jpg', '-640.webp')} 640w, ${post.img.replace('.jpg', '.webp')} 1280w`} sizes="(max-width: 768px) 100vw, 1152px" type="image/webp" />
        <img src={post.img} srcset={`${post.img.replace('.jpg', '-640.jpg')} 640w, ${post.img} 1280w`} sizes="(max-width: 768px) 100vw, 1152px" alt={post.title} width="1200" height="800" fetchpriority="high" class="reveal w-full rounded-2xl object-cover" />
      </picture>
      <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_300px]">
        <article class="reveal">
          <div class="flex items-center gap-3 border-b border-line pb-5">
            {author && (<picture class="contents"><source srcset={author.img.replace('.jpg', '.webp')} type="image/webp" /><img src={author.img} alt={`Portrait of ${author.name}`} width="96" height="96" loading="lazy" class="h-12 w-12 rounded-full object-cover" /></picture>)}
            <div>
              <p class="font-display font-extrabold">{post.author}</p>
              <p class="text-sm text-white/55">{post.authorRole} · {post.date} · {post.readingTime} · {wordCount} words</p>
            </div>
          </div>
          <p class="mt-6 border-l-4 border-lime pl-4 font-display text-xl font-bold leading-relaxed text-white/90">{post.excerpt}</p>
          {post.body.map((para, i) => (
            <p class="mt-5 leading-relaxed text-white/75">{para}</p>
          ))}
          <div class="mt-10 rounded-2xl bg-lime p-6 text-ink">
            <h2 class="font-display text-xl font-black">Want this for your brand?</h2>
            <p class="mt-2 text-sm text-ink/75">Tell us what you are building — we reply within one working day with honest next steps and a fixed quote.</p>
            <a href="/contact/" class="mt-4 inline-block rounded-full bg-ink px-6 py-3 text-sm font-bold text-white transition hover:bg-ink-2">Start your project →</a>
          </div>
        </article>
        <aside class="reveal h-fit space-y-4 lg:sticky lg:top-28">
          <div class="rounded-2xl bg-card p-6">
            <h2 class="font-display text-lg font-extrabold">About the author</h2>
            {author && <p class="mt-2 text-sm leading-relaxed text-white/65">{author.bio}</p>}
            <a href="/team/" class="mt-3 inline-block text-sm font-semibold text-lime underline-offset-4 hover:underline">Meet the full team →</a>
          </div>
          <div class="rounded-2xl bg-card p-6">
            <h2 class="font-display text-lg font-extrabold">Read next</h2>
            <ul class="mt-3 space-y-3">
              {related.map((r) => (
                <li><a href={`/blog/${r.slug}/`}` class="text-sm font-semibold leading-snug text-white/80 transition hover:text-lime">{r.title}</a><p class="text-xs text-white/45">{r.category} · {r.readingTime}</p></li>
              ))}
            </ul>
            <a href="/blog/" class="mt-4 inline-block text-sm font-semibold text-lime underline-offset-4 hover:underline">All articles →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
