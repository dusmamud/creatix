---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { contact, services } from '../data/site';
const lead = 'Tell us about your project. We reply within one working day. There is no backend on this form — submitting opens your mail app with everything prefilled, so nothing is lost.';
---
<Layout title="Contact Us — Creatix" description="Contact Creatix: start a project, ask a question, or book a free discovery call. We reply within one working day." lead={lead} ogImage="https://creatiix.pages.dev/images/og-contact.jpg">
  <PageHero eyebrow="Contact Us" title="Let's create something exceptional." lead={lead} />
  <section class="bg-ink px-4 py-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_360px]">
      <form id="contact-form" class="reveal rounded-2xl bg-card p-6 sm:p-8" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="cf-name" class="text-sm font-semibold">Your name *</label>
            <input id="cf-name" name="name" required minlength="2" placeholder="Full name" class="mt-1.5 w-full rounded-xl border border-line bg-ink px-4 py-3 text-sm outline-none placeholder:text-white/35 focus:border-lime" />
          </div>
          <div>
            <label for="cf-email" class="text-sm font-semibold">Email *</label>
            <input id="cf-email" name="email" type="email" required placeholder="you@company.com" class="mt-1.5 w-full rounded-xl border border-line bg-ink px-4 py-3 text-sm outline-none placeholder:text-white/35 focus:border-lime" />
          </div>
        </div>
        <div class="mt-4">
          <label for="cf-service" class="text-sm font-semibold">Service needed</label>
          <select id="cf-service" name="service" class="mt-1.5 w-full rounded-xl border border-line bg-ink px-4 py-3 text-sm outline-none focus:border-lime">
            <option value="">Not sure yet</option>
            {services.map((s) => (<option value={s.title}>{s.title} — {s.price}</option>))}
            <option value="Something else">Something else</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="cf-budget" class="text-sm font-semibold">Budget (optional)</label>
          <select id="cf-budget" name="budget" class="mt-1.5 w-full rounded-xl border border-line bg-ink px-4 py-3 text-sm outline-none focus:border-lime">
            <option value="">Prefer not to say</option>
            <option>Under ₹50,000</option>
            <option>₹50,000 – ₹1,00,000</option>
            <option>₹1,00,000 – ₹3,00,000</option>
            <option>Above ₹3,00,000</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="cf-message" class="text-sm font-semibold">Tell us about your project *</label>
          <textarea id="cf-message" name="message" required minlength="10" rows="5" placeholder="What are you building? Who is it for? When do you need it?" class="mt-1.5 w-full rounded-xl border border-line bg-ink px-4 py-3 text-sm outline-none placeholder:text-white/35 focus:border-lime"></textarea>
        </div>
        <p id="cf-error" class="mt-3 hidden text-sm font-semibold text-red-400" role="alert"></p>
        <p id="cf-ok" class="mt-3 hidden text-sm font-semibold text-lime" role="status">Thanks! Your mail app should open with the message prefilled — just press send.</p>
        <button type="submit" class="mt-5 w-full rounded-full bg-lime py-3.5 text-sm font-bold text-ink transition hover:bg-white sm:w-auto sm:px-8">Send Message →</button>
        <p class="mt-3 text-xs text-white/45">No backend yet — this form opens your email app (mailto) with the message prefilled. Your details never leave your device until you press send.</p>
      </form>
      <aside class="reveal space-y-4">
        <div class="rounded-2xl bg-card p-6">
          <h2 class="font-display text-lg font-extrabold">Reach us directly</h2>
          <p class="mt-3 text-sm"><span class="text-white/55">Email</span><br /><a class="font-semibold text-lime underline-offset-4 hover:underline" href={`mailto:${contact.email}`}>{contact.email}</a></p>
          <p class="mt-3 text-sm"><span class="text-white/55">Phone</span><br /><a class="font-semibold" href={contact.phoneHref}>{contact.phoneDisplay}</a></p>
          <p class="mt-3 text-sm"><span class="text-white/55">Hours</span><br />{contact.hours}</p>
          <p class="mt-3 text-sm"><span class="text-white/55">Studio</span><br />{contact.location}</p>
        </div>
        <div class="rounded-2xl bg-lime p-6 text-ink">
          <h2 class="font-display text-lg font-extrabold">Prefer a call?</h2>
          <p class="mt-2 text-sm text-ink/75">Book a free 30-minute discovery call — we will talk through your idea and give you a fixed quote.</p>
          <a href={`mailto:${contact.email}?subject=${encodeURIComponent('Free discovery call — Creatix')}`} class="mt-4 block rounded-full bg-ink px-5 py-3 text-center text-sm font-bold text-white">Book a free call →</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const err = document.getElementById('cf-error');
    const ok = document.getElementById('cf-ok');
    err?.classList.add('hidden');
    ok?.classList.add('hidden');
    const name = (document.getElementById('cf-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('cf-email') as HTMLInputElement).value.trim();
    const service = (document.getElementById('cf-service') as HTMLSelectElement).value;
    const budget = (document.getElementById('cf-budget') as HTMLSelectElement).value;
    const message = (document.getElementById('cf-message') as HTMLTextAreaElement).value.trim();
    const fail = (m: string) => { if (err) { err.textContent = m; err.classList.remove('hidden'); } };
    if (name.length < 2) return fail('Please enter your name.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail('Please enter a valid email address.');
    if (message.length < 10) return fail('Please tell us a little more about your project (at least 10 characters).');
    const body = `Hi Creatix team,\n\nName: ${name}\nEmail: ${email}\nService: ${service || 'Not sure yet'}\nBudget: ${budget || 'Not shared'}\n\n${message}`;
    window.location.href = `mailto:hello@creatix.in?subject=${encodeURIComponent('New project enquiry — ' + name)}&body=${encodeURIComponent(body)}`;
    ok?.classList.remove('hidden');
    form.reset();
  });
</script>
